<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <dev.russell.yagi.common.common.prefs.supportv7.ATESwitchPreference
        android:layout="@layout/list_item_view_switch"
        android:defaultValue="false"
        android:key="pref_ad_skip_enabled"
        android:summary="@string/pref_ad_skip_enabled_sum"
        android:title="@string/detect_ads"
        app:icon="@drawable/ic_skip_24dp" />
    <dev.russell.yagi.common.common.prefs.supportv7.ATEListPreference
        android:layout="@layout/list_item_view"
        android:defaultValue="medium"
        android:entries="@array/ad_skip_sensitivity_options"
        android:entryValues="@array/ad_skip_sensitivity_values"
        android:key="pref_ad_skip_sensitivity"
        android:summary="@string/pref_ad_skip_sensitivity_sum"
        android:title="@string/pref_ad_skip_sensitivity_title" />
    <dev.russell.yagi.common.common.prefs.supportv7.ATESwitchPreference
        android:layout="@layout/list_item_view_switch"
        android:defaultValue="true"
        android:key="pref_ad_skip_use_transcripts"
        android:summary="@string/pref_ad_skip_use_transcripts_sum"
        android:title="@string/pref_ad_skip_use_transcripts_title" />
    <dev.russell.yagi.common.common.prefs.supportv7.ATEPreference
        android:layout="@layout/list_item_view"
        android:dependency="pref_ad_skip_use_transcripts"
        android:key="pref_ad_skip_claude_key"
        android:persistent="false"
        android:summary="@string/pref_ad_skip_claude_key_sum_unset"
        android:title="@string/pref_ad_skip_claude_key_title" />
    <dev.russell.yagi.common.common.prefs.supportv7.ATESwitchPreference
        android:layout="@layout/list_item_view_switch"
        android:defaultValue="false"
        android:dependency="pref_ad_skip_use_transcripts"
        android:key="pref_ad_skip_self_promo"
        android:summary="@string/pref_ad_skip_self_promo_sum"
        android:title="@string/pref_ad_skip_self_promo_title" />
    <dev.russell.yagi.common.common.prefs.supportv7.ATESwitchPreference
        android:layout="@layout/list_item_view_switch"
        android:defaultValue="true"
        android:key="pref_ad_skip_analyze_on_download"
        android:summary="@string/pref_ad_skip_analyze_on_download_sum"
        android:title="@string/pref_ad_skip_analyze_on_download_title" />
    <dev.russell.yagi.common.common.prefs.supportv7.ATESwitchPreference
        android:layout="@layout/list_item_view_switch"
        android:defaultValue="true"
        android:key="pref_ad_skip_show_snackbar"
        android:summary="@string/pref_ad_skip_show_snackbar_sum"
        android:title="@string/pref_ad_skip_show_snackbar_title" />
</PreferenceScreen>
